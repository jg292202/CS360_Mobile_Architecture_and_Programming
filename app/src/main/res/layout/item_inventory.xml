<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="?attr/colorSurface"
    android:elevation="4dp">

    <TextView
        android:id="@+id/itemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Item Name"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/deleteButton"/>

    <ImageButton
        android:id="@+id/deleteButton"
        android:contentDescription="Delete item"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_delete"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/deleteLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/deleteButton"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:id="@+id/itemSKU"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SKU123"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/itemName"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/itemCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/itemSKU"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/itemQuantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Qty: 10"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/itemCategory"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/increaseButton"
        android:contentDescription="Increase quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+"
        app:layout_constraintTop_toBottomOf="@id/itemQuantity"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/decreaseButton"
        android:contentDescription="Decrease quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="-"
        app:layout_constraintTop_toBottomOf="@id/itemQuantity"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/increaseButton"
        android:layout_marginStart="8dp"/>



</androidx.constraintlayout.widget.ConstraintLayout>